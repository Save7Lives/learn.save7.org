+
+      {/* --- What's included ----------------------------------------------- */}
+      <section className={SECTION}>
+        <div className={WRAP}>
+          <Display as="h2" className={H2}>
+            What the course includes
+          </Display>
+          <ul className="mt-[1.875rem] grid list-none gap-x-8 gap-y-[1.625rem] p-0 min-[760px]:grid-cols-2">
+            {INCLUDES.map(([title, body, icon], i) => (
