@@ -0,0 +1,55 @@
+import { Icon } from "@/components/ui/icons";
+import { cx } from "@/components/ui/primitives";
+
+/**
+ * The dotted stepper's two nodes (#73). Editorial-only pieces: the Portal's rail
+ * stepper (#85) is a different thing, so these are not shared with it.
+ *
+ * A Stage dot has three states, told by fill, ring and weight, never by colour alone:
+ * passed (teal fill, check), up next (navy ring, thick) and not started (grey ring).
+ * The up-next ring marks exactly one Stage on a page, the recommended Level's.
+ */
+export type StepState = "done" | "now" | "todo";
+
+export function StepDot({
+  n,
+  state,
+  className,
+}: {
+  /** The Stage's number within its Level (numbers restart per Level). */
+  n: number;
+  state: StepState;
+  className?: string;
+}) {
+  return (
+    <span
+      aria-hidden="true"
+      className={cx(
+        "relative grid size-8 shrink-0 place-items-center rounded-full font-display text-sm font-bold",
+        // One background per state: two bg-* classes would fight on stylesheet order.
+        state === "done" && "bg-teal text-navy",
+        state === "now" && "border-[3px] border-navy bg-white text-navy",
+        state === "todo" && "border-2 border-line-strong bg-white text-grey",
+        className,
+      )}
+    >
+      {state === "done" ? <Icon name="check" className="size-4" strokeWidth={2.5} /> : n}
+    </span>
+  );
+}
+
+/** The node that closes a Level: the Certificate, filled teal once it is earned. */
+export function AwardNode({ earned, className }: { earned: boolean; className?: string }) {
+  return (
+    <span
+      aria-hidden="true"
+      className={cx(
+        "grid size-8 shrink-0 place-items-center rounded-full",
+        earned ? "bg-teal text-navy" : "bg-teal-100 text-teal-ink",
+        className,
+      )}
+    >
+      <Icon name="award" className="size-4" strokeWidth={2.25} />
+    </span>
+  );
+}
