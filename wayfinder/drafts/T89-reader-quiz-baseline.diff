+
+/**
+ * The outline icon set (#68): 24px grid, 1.75px stroke, no fills, no stock
+ * clip-art. Only the icons the reader, the Stage Quiz and the Baseline need live
+ * here; add to it when a screen needs another, drawn the same way.
+ *
+ * Every icon is decorative. The word beside it, or an `aria-label` on its
+ * control, carries the meaning, so a state is never colour or shape alone.
+ */
+const PATHS = {
+  check: <path d="m5 12.5 4.5 4.5L19 7.5" />,
+  x: <path d="m6.5 6.5 11 11M17.5 6.5l-11 11" />,
