+  ),
+  refresh: (
+    <>
+      <path d="M20 11A8 8 0 0 0 5.6 6.6L4 8.5" />
+      <path d="M4 4v4.5h4.5" />
+      <path d="M4 13a8 8 0 0 0 14.4 4.4l1.6-1.9" />
+      <path d="M20 20v-4.5h-4.5" />
+    </>
+  ),
+  award: (
+    <>
+      <circle cx="12" cy="9" r="6" />
+      <path d="M8.6 14.2 7 22l5-3 5 3-1.6-7.8" />
+    </>
+  ),
+  chev: <path d="m6 9 6 6 6-6" />,
+  back: <path d="M19 12H5M11 6l-6 6 6 6" />,
+  arrow: <path d="M5 12h14M13 6l6 6-6 6" />,
+  flag: <path d="M5 21V4M5 4h11l-2 4 2 4H5" />,
+} satisfies Record<string, ReactNode>;
+
+export type IconName = keyof typeof PATHS;
+
+export function Icon({
+  name,
+  size = "md",
+  className,
+}: {
+  name: IconName;
+  /** `sm` is the 16px, heavier-stroked glyph that sits inside pills and dots. */
+  size?: "sm" | "md" | "lg";
+  className?: string;
+}) {
+  return (
+    <svg
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      strokeWidth={size === "sm" ? 2.25 : 1.75}
+      aria-hidden="true"
+      focusable="false"
+      className={cx(
+        "shrink-0",
+        // A caller that sets its own size-* (responsive chips) owns the size.
+        !className?.includes("size-") &&
+          (size === "sm" ? "size-4" : size === "lg" ? "size-6" : "size-5"),
+        className,
+      )}
+    >
+      {PATHS[name]}
+    </svg>
+  );
+}
+
+const CHIP_SIZES = {
+  md: "size-10",
+  /** The quiz's fact chips: small on a phone, full size from 40rem. */
+  fact: "size-7 sm:size-10",
+  /** A scenario box's info mark. */
+  scenario: "size-8",
+} as const;
+
+/** An outline icon in a tinted circle: the deck's icon treatment. */
+export function IconChip({
+  name,
+  tone = "teal",
+  size = "md",
+  className,
+}: {
+  name: IconName;
+  tone?: "teal" | "pink" | "neutral";
+  size?: keyof typeof CHIP_SIZES;
+  className?: string;
+}) {
+  return (
+    <span
+      aria-hidden="true"
+      className={cx(
+        "grid shrink-0 place-items-center rounded-full",
+        CHIP_SIZES[size],
+        tone === "teal" && "bg-teal-100 text-teal-ink",
+        tone === "pink" && "bg-pink-100 text-pink",
+        tone === "neutral" && "bg-line text-navy",
+        className,
+      )}
+    >
+      <Icon name={name} size={size === "md" ? "md" : "sm"} />
+    </span>
+  );
+}
