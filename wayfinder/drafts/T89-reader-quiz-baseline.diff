+++ b/src/components/ui/status.tsx
@@ -0,0 +1,97 @@
+import type { ReactNode } from "react";
+import { cx } from "@/components/ui/primitives";
+import { Icon, type IconName } from "@/components/ui/icons";
+
+/**
+ * The status pill, the stepper dot and the numbered pill (#74).
+ *
+ * Each one says its state in words or a glyph as well as colour, which is the rule
+ * for every state in the reader, the Stage Quiz and the Baseline: a pill is a tint,
+ * a hairline, an icon and navy text; a dot is a check, a ring or a number.
+ */
+
+const PILL_TONES = {
+  /** Not started: white with a strong hairline. */
+  none: { surface: "border-line-strong bg-white", icon: "text-navy" },
+  /** Not passed yet, Not answered: pink-50. */
+  warn: { surface: "border-pink-line bg-pink-50", icon: "text-pink" },
+  /** Passed, Answered, Correct: teal-50. */
+  good: { surface: "border-teal-line bg-teal-50", icon: "text-teal-ink" },
+  /** Practice attempt: white with a strong hairline and a grey icon. */
+  practice: { surface: "border-line-strong bg-white", icon: "text-grey" },
+} as const;
+
+export type StatusTone = keyof typeof PILL_TONES;
+
+export function StatusPill({
+  tone,
+  icon,
+  children,
+  className,
+}: {
+  tone: StatusTone;
+  icon: IconName;
+  children: ReactNode;
+  className?: string;
+}) {
+  const t = PILL_TONES[tone];
+  return (
+    <span
+      className={cx(
+        "inline-flex items-center gap-1.5 whitespace-nowrap rounded-pill border py-1 pl-2 pr-3 text-[0.8125rem] font-medium leading-5 text-navy",
+        t.surface,
+        className,
+      )}
+    >
+      <Icon name={icon} size="sm" className={t.icon} />
+      {children}
+    </span>
+  );
+}
+
+export type DotState = "done" | "now" | "todo";
+
+/**
+ * One step on a dotted stepper: `teal` with a navy check when done, a navy ring for
+ * where you are, a grey ring for the rest. The number shows on the last two, so a
+ * stepper reads in order even with the colour taken away.
+ */
+export function StepDot({
+  state,
+  n,
+  className,
+}: {
+  state: DotState;
+  n: number;
+  className?: string;
+}) {
+  return (
+    <span
+      aria-hidden="true"
+      className={cx(
+        "grid size-8 shrink-0 place-items-center rounded-full font-(family-name:--font-display) text-sm font-bold leading-none",
+        state === "done" && "bg-teal text-navy",
+        state === "now" && "border-[3px] border-navy bg-white text-navy",
+        state === "todo" && "border-2 border-line-strong bg-white text-grey",
+        className,
+      )}
+    >
+      {state === "done" ? <Icon name="check" size="sm" /> : n}
+    </span>
+  );
+}
+
+/** A teal circle with a navy numeral: the deck's numbered pill. */
+export function NumberPill({ n, className }: { n: number; className?: string }) {
+  return (
+    <span
+      aria-hidden="true"
+      className={cx(
+        "grid size-8 shrink-0 place-items-center rounded-full bg-teal font-(family-name:--font-display) text-sm font-bold leading-none text-navy",
+        className,
+      )}
+    >
+      {n}
+    </span>
+  );
+}
