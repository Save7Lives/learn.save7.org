diff --git a/src/components/admin/RuleEditor.tsx b/src/components/admin/RuleEditor.tsx
new file mode 100644
index 0000000..d19495f
--- /dev/null
+++ b/src/components/admin/RuleEditor.tsx
@@ -0,0 +1,115 @@
+"use client";
+
+import { useActionState, useState } from "react";
+import { Notice } from "@/components/portal/Panel";
+import { cx } from "@/components/ui/primitives";
+import { readsEligible } from "@/lib/admin/flags";
+import { saveEligibilityRuleAction, type RuleFormState } from "@/app/admin/eligibility/actions";
+
+/**
+ * The Eligibility Rule editor (#72, #84): a checkbox per Level-complete flag, the
+ * count that would read as eligible before anything is saved, and a save that always
+ * makes version N+1. The count is worked out here from each Student's held flags
+ * (names and ids never reach the browser), the same AND the database evaluator uses.
+ */
+export function RuleEditor({
+  options,
+  current,
+  held,
+  action = saveEligibilityRuleAction,
+}: {
+  options: Array<{ flag: string; label: string }>;
+  current: { version: number; flags: string[] } | null;
+  /** One list of held flags per Student, no identity. */
+  held: string[][];
+  /** The server action; a test page passes a stub. */
+  action?: (previous: RuleFormState, formData: FormData) => Promise<RuleFormState>;
+}) {
+  const [state, submit, pending] = useActionState(action, undefined);
+  const [selected, setSelected] = useState<string[]>(current?.flags ?? []);
+
+  const same =
+    current !== null && selected.length === current.flags.length && selected.every((f) => current.flags.includes(f));
+  const empty = selected.length === 0;
+  const total = held.length;
+  const would = held.filter((h) => readsEligible(h, selected)).length;
+  const now = current ? held.filter((h) => readsEligible(h, current.flags)).length : 0;
+  const next = (current?.version ?? 0) + 1;
+
+  const toggle = (flag: string) =>
+    setSelected((s) => (s.includes(flag) ? s.filter((f) => f !== flag) : [...s, flag]));
+
+  return (
+    <form action={submit} className="flex flex-col gap-4">
+      <input type="hidden" name="baseVersion" value={current?.version ?? ""} />
+
+      <fieldset className="m-0 flex flex-col gap-2.5 border-0 p-0">
+        <legend className="sr-only">Required flags</legend>
+        {options.map((o) => {
+          const on = selected.includes(o.flag);
+          return (
+            <label
+              key={o.flag}
+              className={cx(
+                "flex cursor-pointer items-start gap-3 rounded-xl border-[1.5px] px-3.5 py-3",
+                on ? "border-navy bg-teal-50" : "border-line-strong bg-white",
+              )}
+            >
+              <input
+                type="checkbox"
+                name="flag"
+                value={o.flag}
+                checked={on}
+                onChange={() => toggle(o.flag)}
+                className="mt-0.5 size-5 shrink-0 accent-pink"
+              />
+              <span>
+                <span className="block font-medium text-navy">{o.label}</span>
+                <span className="block text-[0.8125rem] text-grey">A Student must have this flag to read as eligible.</span>
+              </span>
+            </label>
+          );
+        })}
+      </fieldset>
+
+      {empty ? (
+        <Notice tone="warn" icon="alert" role="status">
+          A rule with no flags would make every Student eligible. Pick at least one.
+        </Notice>
+      ) : (
+        <Notice icon="chart" role="status">
+          <span className="font-medium">
+            {would} of {total}
+          </span>{" "}
+          Students would read as eligible under this selection
+          {same || !current ? "" : `, against ${now} under version ${current.version}`}. All flags must be true.
+        </Notice>
+      )}
+
+      {state?.error ? (
+        <Notice tone="warn" icon="alert" role="status">
+          {state.error}
+        </Notice>
+      ) : null}
+
+      <div className="flex flex-wrap items-center gap-3">
+        <button
+          type="submit"
+          disabled={same || empty || pending}
+          className="inline-flex min-h-11 items-center rounded-[10px] bg-pink px-4 text-sm font-semibold text-white hover:bg-navy disabled:cursor-not-allowed disabled:border-2 disabled:border-line disabled:bg-white disabled:text-grey disabled:hover:bg-white"
+        >
+          {pending ? "Saving…" : `Save as version ${next}`}
+        </button>
+        <span className="text-sm text-grey">
+          {same
+            ? "Change a flag to save a new version."
+            : empty
+              ? "Pick at least one flag to save."
+              : current
+              ? `Saving adds version ${next}. Version ${current.version} is kept as it is.`
+              : "Saving adds version 1."}
+        </span>
+      </div>
+    </form>
+  );
+}
diff --git a/src/components/admin/RuleView.tsx b/src/components/admin/RuleView.tsx
new file mode 100644
index 0000000..2495102
--- /dev/null
+++ b/src/components/admin/RuleView.tsx
@@ -0,0 +1,141 @@
+import { Icon } from "@/components/ui/icons";
+import { Notice, PageHeader, Panel } from "@/components/portal/Panel";
+import { DataTable } from "@/components/portal/DataTable";
+import { flagLabel, heldFlags, eligibleCount, type Catalogue, type EligibilityRule, type StudentRecord } from "@/lib/admin/model";
+import { levelFlag } from "@/lib/admin/flags";
+import { formatShortDate } from "@/lib/admin/format";
+import { RuleEditor } from "./RuleEditor";
+import type { RuleFormState } from "@/app/admin/eligibility/actions";
+
+/**
+ * The Eligibility Rule screen (#72, #84): the current rule, an editor that saves a
+ * new version, and the version history. A rule is data, never edited in place, so
+ * the history is every version ever saved.
+ */
+
+export const VersionPill = ({ children }: { children: React.ReactNode }) => (
+  <span className="inline-flex items-center rounded-pill bg-navy px-2.5 py-[3px] font-display text-xs font-bold uppercase leading-tight tracking-[0.06em] text-white">
+    {children}
+  </span>
+);
+
+export function FlagChips({ flags, catalogue }: { flags: string[]; catalogue: Catalogue }) {
+  return (
+    <ul className="m-0 flex list-none flex-wrap gap-1.5 p-0">
+      {flags.map((f) => (
+        <li
+          key={f}
+          className="inline-flex items-center gap-1.5 rounded-lg border border-teal-line bg-teal-50 py-1 pl-2 pr-2.5 text-[0.8125rem] font-medium text-navy"
+        >
+          <Icon name="check" className="size-3.5 shrink-0 stroke-[2.25] text-teal-ink" />
+          {flagLabel(f, catalogue)}
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+export function RuleView({
+  catalogue,
+  students,
+  rules,
+  saved,
+  action,
+}: {
+  catalogue: Catalogue;
+  students: StudentRecord[];
+  /** Every version, newest first. */
+  rules: EligibilityRule[];
+  /** The version just saved, from the redirect. */
+  saved: number | null;
+  action?: (previous: RuleFormState, formData: FormData) => Promise<RuleFormState>;
+}) {
+  const current = rules[0] ?? null;
+
+  return (
+    <>
+      <PageHeader
+        title="Eligibility rule"
+        lede="Decides which Students read as eligible for Nerve Center. Editing creates a new version and never changes an old one."
+      />
+
+      {saved !== null ? (
+        <div className="mb-4">
+          <Notice icon="check-circle" role="status">
+            Saved as version {saved}. Earlier versions are kept in the history below.
+          </Notice>
+        </div>
+      ) : null}
+
+      <div className="grid items-start gap-4 min-[1100px]:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
+        <div className="flex min-w-0 flex-col gap-4">
+          <Panel
+            title="Current rule"
+            aside={current ? <VersionPill>Version {current.version}</VersionPill> : null}
+            lede={
+              current
+                ? `Created ${formatShortDate(current.createdAt)}${current.createdByName ? ` by ${current.createdByName}` : ""}.`
+                : "No rule has been saved yet."
+            }
+          >
+            {current ? (
+              <div className="flex flex-col gap-3">
+                <FlagChips flags={current.requiredFlags} catalogue={catalogue} />
+                <p className="font-display text-[2rem] font-extrabold leading-tight text-navy">
+                  {eligibleCount(students)}{" "}
+                  <span className="font-sans text-[0.9375rem] font-medium text-grey">
+                    of {students.length} Students read as eligible
+                  </span>
+                </p>
+              </div>
+            ) : (
+              <Notice icon="info">Until a rule is saved, no one reads as eligible.</Notice>
+            )}
+          </Panel>
+
+          <Panel title="Version history">
+            <DataTable
+              caption="Every version of the Eligibility Rule, newest first"
+              minWidth="34rem"
+              empty="No versions yet."
+              columns={[
+                { key: "v", header: "Version", nowrap: true },
+                { key: "f", header: "Required flags" },
+                { key: "b", header: "Created by", nowrap: true },
+                { key: "c", header: "Created", nowrap: true },
+              ]}
+              rows={rules.map((r, i) => ({
+                key: String(r.version),
+                cells: [
+                  <span key="v" className="inline-flex items-center gap-2">
+                    {r.version}
+                    {i === 0 ? <VersionPill>Current</VersionPill> : null}
+                  </span>,
+                  <FlagChips key="f" flags={r.requiredFlags} catalogue={catalogue} />,
+                  <span key="b" className="font-normal text-navy">
+                    {r.createdByName ?? "Unknown"}
+                  </span>,
+                  <span key="c" className="font-normal text-navy">
+                    {formatShortDate(r.createdAt)}
+                  </span>,
+                ],
+              }))}
+            />
+          </Panel>
+        </div>
+
+        <Panel
+          title="Edit the rule"
+          lede="A Student reads as eligible when every flag below is true. The rule never reads Baseline scores or engagement."
+        >
+          <RuleEditor
+            options={catalogue.map((l) => ({ flag: levelFlag(l.slug), label: `${l.title} Level complete` }))}
+            current={current ? { version: current.version, flags: current.requiredFlags } : null}
+            held={students.map(heldFlags)}
+            action={action}
+          />
+        </Panel>
+      </div>
+    </>
+  );
+}
diff --git a/src/components/admin/StudentView.tsx b/src/components/admin/StudentView.tsx
new file mode 100644
index 0000000..d2648ee
--- /dev/null
+++ b/src/components/admin/StudentView.tsx
@@ -0,0 +1,336 @@
+import Link from "next/link";
+import { Icon } from "@/components/ui/icons";
+import { StatCard, type RailState } from "@/components/portal/Portal";
+import { LevelCard, type LevelCardStage } from "@/components/portal/LevelCard";
+import { DataTable, CellSub } from "@/components/portal/DataTable";
+import { Notice, Panel } from "@/components/portal/Panel";
+import {
+  SITTING_SLOTS,
+  currentLevel,
+  flagLabel,
+  latestSitting,
+  levelImprovement,
+  liveCertificates,
+  percent,
+  heldFlags,
+  stagesPassed,
+  type Catalogue,
+  type EligibilityRule,
+  type StudentRecord,
+} from "@/lib/admin/model";
+import { formatDate, formatPct, formatPoints, formatShortDate, initials } from "@/lib/admin/format";
+import type { ActivityEvent } from "@/lib/admin/data";
+
+/**
+ * A Student's Progress Record, "where they are" first (#72, #84): the four stat cards,
+ * the eligibility line, each Level as a card with its Stage stepper, the Certificate
+ * line, then the Baseline table with an Improvement row. Dashboard activity closes
+ * the page (#81). Presentational: every state of a record renders from plain data.
+ */
+
+const EVENT_WORDS: Record<string, string> = {
+  lesson_view: "Opened a lesson",
+  quiz_start: "Started a Stage Quiz",
+  quiz_submit: "Submitted a Stage Quiz",
+  module_complete: "Finished a Stage’s lessons",
+  level_start: "Started a Level",
+  certificate_issue: "Certificate issued",
+  video_progress: "Watched part of the film",
+  profile_update: "Updated their profile",
+};
+
+export function StudentView({
+  student,
+  catalogue,
+  rule,
+  activity,
+}: {
+  student: StudentRecord;
+  catalogue: Catalogue;
+  /** The current Eligibility Rule, or null before one is saved. */
+  rule: EligibilityRule | null;
+  activity: ActivityEvent[];
+}) {
+  const stagesTotal = catalogue.reduce((n, l) => n + l.stages.length, 0);
+  const passed = stagesPassed(student);
+  const certs = liveCertificates(student);
+  const sitting = latestSitting(student);
+  const first = student.sittings.some((s) => s.sittingNo === 1);
+  const cur = currentLevel(student, catalogue);
+  const stateText =
+    cur.kind === "awaiting" ? "Awaiting first Sitting" : cur.kind === "complete" ? "All Levels complete" : `In progress on ${cur.title}`;
+
+  /* The Stage they are up to: the first not passed, once Sitting 1 has opened them. */
+  const allStages = catalogue.flatMap((l) => l.stages);
+  const nextStage = first ? (allStages.find((s) => !student.stages[s.slug]?.passedAt)?.slug ?? null) : null;
+
+  const held = heldFlags(student);
+  const eligible = student.signal?.eligible ?? null;
+  const needed = rule ? rule.requiredFlags.filter((f) => !held.includes(f)) : [];
+
+  return (
+    <>
+      <p className="mb-3.5">
+        <Link
+          href="/admin/students"
+          className="inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] font-medium text-teal-ink underline-offset-[3px] hover:underline"
+        >
+          <Icon name="back" className="size-4" />
+          Students
+        </Link>
+      </p>
+
+      <div className="mb-5 flex items-center gap-4">
+        <span
+          aria-hidden="true"
+          className="grid size-[60px] shrink-0 place-items-center rounded-full bg-teal font-display text-lg font-bold leading-none text-navy"
+        >
+          {initials(student.name)}
+        </span>
+        <div className="min-w-0">
+          <h1 className="font-display text-[1.75rem] font-bold leading-tight tracking-[-0.01em] text-navy">{student.name}</h1>
+          <p className="mt-1 text-sm text-grey">
+            Signed up {formatDate(student.signedUpAt)} · {stateText} · Last active {formatDate(student.lastActiveAt)}
+          </p>
+        </div>
+      </div>
+
+      <div className="grid grid-cols-[repeat(auto-fit,minmax(13rem,1fr))] gap-4">
+        <StatCard label="Stages passed" value={String(passed)} unit={`of ${stagesTotal}`} sub="Stage Quizzes passed" icon="book" tint="teal" />
+        <StatCard label="Certificates" value={String(certs.length)} unit={`of ${catalogue.length}`} sub="One per Level" icon="award" tint="pink" />
+        <StatCard label="Baseline Sittings" value={String(student.sittings.length)} unit="of 4" sub="Taken so far" icon="clock" tint="teal" />
+        <StatCard
+          label="Latest Baseline"
+          value={sitting ? formatPct(sitting.totalPct) : "Not taken"}
+          unit={sitting ? `${sitting.totalScore} of ${sitting.totalMax}` : undefined}
+          sub={sitting ? `Sitting ${sitting.sittingNo}` : "No Sitting yet"}
+          icon="chart"
+          tint="pink"
+        />
+      </div>
+
+      <div className="mt-4">
+        <Notice icon="shield">
+          <span className="font-medium">Nerve Center eligibility:</span>{" "}
+          {eligible === null || !student.signal ? (
+            "not evaluated yet."
+          ) : (
+            <>
+              {eligible ? "reads as eligible" : "does not yet read as eligible"} under rule version {student.signal.ruleVersion}, evaluated{" "}
+              {formatDate(student.signal.evaluatedAt)}.
+              {!eligible && rule && needed.length > 0 ? (
+                <> Still needed: {needed.map((f) => flagLabel(f, catalogue)).join(", ")}.</>
+              ) : null}
+            </>
+          )}
+        </Notice>
+      </div>
+
+      <h2 className="mb-3 mt-6 font-display text-[1.375rem] font-bold leading-tight text-navy">Levels and Stages</h2>
+      {catalogue.map((level) => {
+        const done = level.stages.filter((s) => student.stages[s.slug]?.passedAt).length;
+        const completedAt = student.levelCompletedAt[level.slug];
+        const certificate =
+          certs.find((c) => c.levelSlug === level.slug) ??
+          student.certificates.find((c) => c.levelSlug === level.slug) ??
+          null;
+        const onThisLevel = nextStage !== null && level.stages.some((s) => s.slug === nextStage);
+
+        const status = completedAt
+          ? { tone: "done" as const, icon: "award" as const, label: certificate && !certificate.revokedAt ? "Certificate issued" : "Level complete" }
+          : done > 0 || onThisLevel
+            ? { tone: "progress" as const, icon: "clock" as const, label: "In progress" }
+            : { tone: "none" as const, icon: "lock" as const, label: "Not started" };
+
+        const stages: LevelCardStage[] = level.stages.map((st) => {
+          const rec = student.stages[st.slug];
+          const latest = rec?.latest;
+          const attempt = latest ? `Latest attempt ${latest.score} of ${latest.max}` : null;
+          let state: RailState;
+          let detail: React.ReactNode;
+          if (rec?.passedAt) {
+            state = "passed";
+            detail = (
+              <>
+                <span className="font-medium text-navy">Passed {formatShortDate(rec.passedAt)}</span>
+                {attempt ? (
+                  <>
+                    <br />
+                    {attempt}
+                    {latest && !latest.passed ? ", not passed. The Stage stays complete." : ""}
+                  </>
+                ) : null}
+              </>
+            );
+          } else if (!first) {
+            state = "locked";
+            detail = "Opens after the first Sitting";
+          } else if (st.slug === nextStage) {
+            state = "current";
+            detail = attempt ? (
+              <>
+                <span className="font-medium text-navy">Not passed yet</span>
+                <br />
+                {attempt}, not passed
+              </>
+            ) : (
+              <>
+                <span className="font-medium text-navy">Next up</span>
+                <br />
+                Not attempted
+              </>
+            );
+          } else {
+            state = "todo";
+            detail = attempt ? `${attempt}, not passed` : "Not attempted";
+          }
+          return { key: st.slug, title: st.title, state, detail };
+        });
+
+        return (
+          <LevelCard
+            key={level.slug}
+            title={level.title}
+            status={status}
+            passed={done}
+            total={level.stages.length}
+            stages={stages}
+            footer={
+              certificate
+                ? {
+                    icon: "award",
+                    text: (
+                      <>
+                        <span className="font-medium text-navy">
+                          Certificate {certificate.revokedAt ? "revoked" : `issued ${formatDate(certificate.issuedAt)}`}
+                        </span>
+                        , public ID <span className="font-mono text-[0.8125rem] text-navy">{certificate.code}</span>
+                      </>
+                    ),
+                  }
+                : { icon: "lock", text: "No Certificate yet. It is issued when every Stage Quiz in this Level is passed." }
+            }
+          />
+        );
+      })}
+
+      <Panel
+        title="Baseline Sittings"
+        lede="Up to four, on a fixed schedule. Each stores its scores by Level, never the answers."
+        className="mt-6"
+      >
+        <DataTable
+          caption={`${student.name}: Baseline Sittings, with Improvement by Level`}
+          minWidth="40rem"
+          columns={[
+            { key: "s", header: "Sitting", nowrap: true },
+            { key: "t", header: "Taken", nowrap: true },
+            ...catalogue.map((l) => ({ key: l.slug, header: l.title, align: "right" as const })),
+            { key: "tot", header: "Total", align: "right" as const },
+          ]}
+          rows={[
+            ...[1, 2, 3, 4].map((slot) => {
+              const t = student.sittings.find((x) => x.sittingNo === slot);
+              const name = `${slot}. ${SITTING_SLOTS[slot - 1]}`;
+              if (t) {
+                return {
+                  key: `s${slot}`,
+                  cells: [
+                    name,
+                    formatShortDate(t.submittedAt),
+                    ...catalogue.map((l) => {
+                      const s = t.levelScores[l.slug];
+                      return s ? (
+                        <span key={l.slug}>
+                          {percent(s.score, s.max)}%<CellSub>{s.score} of {s.max}</CellSub>
+                        </span>
+                      ) : (
+                        <span key={l.slug} className="text-grey">
+                          n/a
+                        </span>
+                      );
+                    }),
+                    <span key="tot">
+                      <span className="font-medium text-navy">{t.totalPct}%</span>
+                      <CellSub>{t.totalScore} of {t.totalMax}</CellSub>
+                    </span>,
+                  ],
+                };
+              }
+              const owed = slot === 1 ? true : !!student.levelCompletedAt[catalogue[slot - 2]?.slug ?? ""];
+              return {
+                key: `s${slot}`,
+                cells: [
+                  name,
+                  {
+                    span: catalogue.length + 2,
+                    content: (
+                      <span className="text-grey">
+                        {slot === 1
+                          ? "Not taken yet. Stage content stays closed until it is."
+                          : owed
+                            ? "Offered, not taken. Later Sittings are never required."
+                            : `Not yet owed. It follows completing ${catalogue[slot - 2]?.title ?? "a Level"}.`}
+                      </span>
+                    ),
+                  },
+                ],
+              };
+            }),
+            {
+              key: "imp",
+              cells: [
+                "Improvement",
+                <span key="d" className="block max-w-[14rem] whitespace-normal text-xs text-grey">
+                  Sitting after the Level, against Sitting 1
+                </span>,
+                ...catalogue.map((l) => {
+                  const imp = levelImprovement(student.sittings, l.slug, student.levelCompletedAt[l.slug] ?? null);
+                  return imp ? (
+                    <span key={l.slug} className="font-medium text-navy">
+                      {formatPoints(imp.change)}
+                    </span>
+                  ) : (
+                    <span key={l.slug} className="text-grey">
+                      n/a
+                    </span>
+                  );
+                }),
+                <span key="e" />,
+              ],
+            },
+          ]}
+        />
+      </Panel>
+
+      <Panel
+        title="Recent activity"
+        lede="The latest things this Student did on the dashboard. No device or location is recorded."
+        className="mt-4"
+      >
+        {activity.length === 0 ? (
+          <p className="text-sm text-grey">No activity recorded yet.</p>
+        ) : (
+          <DataTable
+            caption={`${student.name}: recent dashboard activity`}
+            minWidth="22rem"
+            columns={[
+              { key: "w", header: "What" },
+              { key: "d", header: "When", align: "right", nowrap: true },
+            ]}
+            rows={activity.map((e, i) => ({
+              key: `${i}-${e.at.getTime()}`,
+              cells: [
+                <span key="w" className="font-normal text-navy">
+                  {EVENT_WORDS[e.type] ?? e.type}
+                  {e.stage ? <CellSub>{e.stage}</CellSub> : null}
+                </span>,
+                formatShortDate(e.at),
+              ],
+            }))}
+          />
+        )}
+      </Panel>
+    </>
+  );
+}
