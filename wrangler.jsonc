/**
 * Cloudflare **Pages** configuration for Transplant Alchemy 101.
 *
 * This was a Workers config until the move to Pages. What changed and why:
 *
 *   * `main` / `assets` are gone. Pages serves `.vercel/output/static`, which
 *     `@cloudflare/next-on-pages` produces, with the app itself in
 *     `_worker.js` inside it. `pages_build_output_dir` is what points at it.
 *   * `alias` is gone. It was a Workers bundler feature; on Pages the bundling is
 *     done by the adapter, and the Node-only driver is kept out of the graph by
 *     the src/lib/db.ts / src/lib/db-node.ts split instead.
 *   * **`routes` is gone, and this is a real loss.** A Workers config could
 *     declare `learn.save7.org` here, so changing where the course lives was a
 *     reviewable pull request. Pages custom domains cannot be declared in
 *     configuration — they are attached in the dashboard, or with
 *     `wrangler pages domain add`. See DEPLOY.md.
 *
 * Deploy with `npm run pages:deploy`, which builds and then uploads.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transplant-alchemy",
  "pages_build_output_dir": ".vercel/output/static",
  "compatibility_date": "2026-08-01",

  // Required by the adapter: the Next server needs Node built-ins (crypto,
  // buffer, async_hooks) even on the edge runtime.
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transplant-alchemy",
      // Created 2026-08-18 in the Cloudflare account zubayyrparak@gmail.com.
      // Committed deliberately: it is an identifier, not a secret, and the build
      // reads this file from the repository. Access is controlled by the account.
      "database_id": "906e5372-8b73-4073-8e78-c701ac64c07d",
      "migrations_dir": "prisma/d1-migrations"
    }
  ],

  "vars": {
    // The public origin, used to build certificate verification links. Tracks
    // what actually resolves rather than what is intended — a dead link printed
    // on a real certificate is worse than an ugly hostname.
    //
    // `learn.save7.org` goes here once the domain is attached (DEPLOY.md), which
    // on Pages is a dashboard action rather than a line in this file.
    "SITE_URL": "https://transplant-alchemy.pages.dev",
    "NEXT_PUBLIC_SITE_URL": "https://transplant-alchemy.pages.dev"
  },

  // Preview deployments get the same bindings and their own origin. Without this
  // block a preview build runs with no vars at all and prints links to nowhere.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "transplant-alchemy",
          "database_id": "906e5372-8b73-4073-8e78-c701ac64c07d",
          "migrations_dir": "prisma/d1-migrations"
        }
      ],
      "vars": {
        "SITE_URL": "https://transplant-alchemy.pages.dev",
        "NEXT_PUBLIC_SITE_URL": "https://transplant-alchemy.pages.dev"
      }
    }
  }

  // AUTH_SECRET is NOT here. It is a secret:
  //   wrangler pages secret put AUTH_SECRET
}
