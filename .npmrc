engine-strict=false
# The Pages adapter (@cloudflare/next-on-pages) and wrangler 4 disagree about
# @cloudflare/workers-types — v4 versus v5, both peerOptional and types only. The
# adapter also runs `npm install` itself inside `npx vercel build`, so the flag has
# to live here rather than on our own install command.
legacy-peer-deps=true
