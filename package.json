{
  "name": "transplant-alchemy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "pages:build": "next-on-pages && node scripts/strip-oversized-media.mjs",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "pages:dev": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "content:emit": "tsx scripts/emit-supabase-content.ts",
    "content:apply": "node scripts/apply-content.mjs",
    "media:upload": "node scripts/upload-media.mjs"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "15.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.16",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.2",
    "pg": "^8.23.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vercel": "47.0.4",
    "wrangler": "^4.124.0"
  }
}
