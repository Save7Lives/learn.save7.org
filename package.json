{
  "name": "transplant-alchemy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && npm run db:push && npm run db:seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo:clear": "tsx prisma/seed-demo-clear.ts",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "db:push": "tsx scripts/apply-schema.ts",
    "db:export": "tsx scripts/export-d1-content.ts",
    "verify": "tsx --conditions=react-server scripts/verify-journey.ts",
    "pages:build": "next-on-pages",
    "pages:deploy": "next-on-pages && wrangler pages deploy .vercel/output/static",
    "pages:dev": "next-on-pages && wrangler pages dev .vercel/output/static",
    "d1:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "next": "15.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.16",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.2",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vercel": "47.0.4",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
