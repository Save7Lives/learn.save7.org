# Copy to .env for local development.
#
# Every value below is public by design. The anon key grants nothing on its own (row
# level security is the boundary), a Google client id appears in every page that uses
# Google sign-in, and the Supabase URL is in every request the browser makes. That is
# why they are committed here. The service-role key must never be added anywhere in
# this project: it bypasses every row level security policy.
#
# Local development writes to the real Save7 Supabase project. There is no local
# database and no seed (see CLAUDE.md).
NEXT_PUBLIC_SUPABASE_URL=https://zbaoziisqroqxfwcnhlb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpiYW96aWlzcXJvcXhmd2NuaGxiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwMTczMjIsImV4cCI6MjEwMTU5MzMyMn0.O_oFqf4kSZZoxDToiwstoFGGqHlQz5PTHO3FAtnHoKI
NEXT_PUBLIC_GOOGLE_CLIENT_ID=572341141393-cv3lctdv0tlp489u357g8jnqsmumv4f0.apps.googleusercontent.com

# The public origin, used to build certificate verification links. SITE_URL wins over
# NEXT_PUBLIC_SITE_URL, because Next inlines NEXT_PUBLIC_ variables into the bundle at
# build time. In production both are set in the Vercel project (Settings ->
# Environment Variables) to https://learn.save7.org. A wrong value produces
# certificates that point at a host which does not serve them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Stage 3 film (its video, poster and captions) is served from. Unset means
# same-origin (the copy in public/media), which is what the app does today. Set it in
# the Vercel project, not here, and only after `npm run media:upload` has put the
# files in the Supabase Storage bucket `learn-media` and its checks have passed.
# MEDIA_BASE_URL=https://zbaoziisqroqxfwcnhlb.supabase.co/storage/v1/object/public/learn-media
